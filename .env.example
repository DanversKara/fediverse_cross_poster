# Copy this file to .env and fill in your values. Never commit .env.

PORT=8080

# --- Bluesky ---
# Use an App Password, not your main account password:
# https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
BLUESKY_SERVICE=https://bsky.social

# --- Mastodon ---
MASTODON_INSTANCE_URL=https://mastodon.social
# Create an access token at:
# https://mastodon.social/settings/applications
# Scopes needed: write:statuses
MASTODON_ACCESS_TOKEN=your_mastodon_access_token
